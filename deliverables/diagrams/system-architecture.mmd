    classDef script fill:#dbeafe,stroke:#1d4ed8,color:#000
    classDef nlp fill:#dcfce7,stroke:#15803d,color:#000
    classDef llm fill:#ffedd5,stroke:#c2410c,color:#000
    classDef human fill:#fee2e2,stroke:#b91c1c,color:#000
    classDef store fill:#f3f4f6,stroke:#374151,color:#000
    classDef sot fill:#e0e7ff,stroke:#312e81,stroke-width:3px,color:#000
    classDef derived fill:#f3f4f6,stroke:#6b7280,stroke-dasharray:5 3,color:#000
    classDef ext fill:#ffffff,stroke:#6b7280,stroke-dasharray:3 3,color:#000
