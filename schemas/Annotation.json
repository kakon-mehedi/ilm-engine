{
  "$defs": {
    "Anchor": {
      "additionalProperties": false,
      "description": "Pointer to an exact span of an original block. `block.text[start:end] == quote` is checked by\n`validation/evidence.py`, which needs the block text.",
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "block_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Block Hash",
          "type": "string"
        },
        "block_id": {
          "title": "Block Id",
          "type": "string"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "page": {
          "title": "Page",
          "type": "integer"
        },
        "pub_ref": {
          "title": "Pub Ref",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "quote_truncated": {
          "default": false,
          "title": "Quote Truncated",
          "type": "boolean"
        },
        "scan_page": {
          "title": "Scan Page",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "status": {
          "default": "valid",
          "enum": [
            "valid",
            "stale",
            "orphaned"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "pub_ref",
        "page",
        "scan_page",
        "block_id",
        "start",
        "end",
        "quote",
        "block_hash"
      ],
      "title": "Anchor",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "How a value was produced. Attached to every derived record.",
      "properties": {
        "method": {
          "enum": [
            "structural",
            "rule",
            "nlp",
            "llm",
            "llm_consensus",
            "human"
          ],
          "title": "Method",
          "type": "string"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "prompt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Id"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "step": {
          "title": "Step",
          "type": "string"
        },
        "step_version": {
          "title": "Step Version",
          "type": "string"
        }
      },
      "required": [
        "method",
        "step",
        "step_version"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "annotation_id": {
      "title": "Annotation Id",
      "type": "string"
    },
    "is_entry_note": {
      "title": "Is Entry Note",
      "type": "boolean"
    },
    "link_method": {
      "enum": [
        "source_ref",
        "marker_match",
        "llm_candidate"
      ],
      "title": "Link Method",
      "type": "string"
    },
    "marker_anchor": {
      "$ref": "#/$defs/Anchor"
    },
    "marker_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Marker Text"
    },
    "origin": {
      "default": "editor_footnote",
      "enum": [
        "author_text",
        "transmission_isnad",
        "editor_text",
        "editor_footnote",
        "ai_generated"
      ],
      "title": "Origin",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "source_block_id": {
      "title": "Source Block Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "verified",
        "candidate",
        "unlinked"
      ],
      "title": "Status",
      "type": "string"
    },
    "target_block_ids": {
      "items": {
        "type": "string"
      },
      "title": "Target Block Ids",
      "type": "array"
    },
    "type": {
      "enum": [
        "footnote",
        "endnote",
        "sidenote",
        "nested_footnote"
      ],
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "annotation_id",
    "type",
    "source_block_id",
    "marker_anchor",
    "target_block_ids",
    "marker_text",
    "link_method",
    "is_entry_note",
    "status",
    "provenance"
  ],
  "title": "Annotation",
  "type": "object"
}
