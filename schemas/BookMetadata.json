{
  "$defs": {
    "Anchor": {
      "additionalProperties": false,
      "description": "Pointer to an exact span of an original block. `block.text[start:end] == quote` is checked by\n`validation/evidence.py`, which needs the block text.",
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "block_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Block Hash",
          "type": "string"
        },
        "block_id": {
          "title": "Block Id",
          "type": "string"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "page": {
          "title": "Page",
          "type": "integer"
        },
        "pub_ref": {
          "title": "Pub Ref",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "quote_truncated": {
          "default": false,
          "title": "Quote Truncated",
          "type": "boolean"
        },
        "scan_page": {
          "title": "Scan Page",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "status": {
          "default": "valid",
          "enum": [
            "valid",
            "stale",
            "orphaned"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "pub_ref",
        "page",
        "scan_page",
        "block_id",
        "start",
        "end",
        "quote",
        "block_hash"
      ],
      "title": "Anchor",
      "type": "object"
    },
    "MetadataField": {
      "additionalProperties": false,
      "properties": {
        "assertion": {
          "enum": [
            "stated",
            "inferred"
          ],
          "title": "Assertion",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "conflicts": {
          "default": [],
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "normalized": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized"
        },
        "origin": {
          "enum": [
            "author_text",
            "transmission_isnad",
            "editor_text",
            "editor_footnote",
            "ai_generated"
          ],
          "title": "Origin",
          "type": "string"
        },
        "review_status": {
          "enum": [
            "auto_approved",
            "pending_review",
            "approved",
            "rejected",
            "edited",
            "reprocess_requested"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/MetadataSource"
          },
          "title": "Sources",
          "type": "array"
        },
        "value": {
          "title": "Value"
        }
      },
      "required": [
        "value",
        "sources",
        "assertion",
        "origin",
        "confidence",
        "review_status"
      ],
      "title": "MetadataField",
      "type": "object"
    },
    "MetadataSource": {
      "additionalProperties": false,
      "properties": {
        "anchors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Anchor"
          },
          "title": "Anchors",
          "type": "array"
        },
        "kind": {
          "enum": [
            "existing_metadata",
            "book_content",
            "pdf_visual",
            "external_catalog"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "required": [
        "kind"
      ],
      "title": "MetadataSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "author": {
      "$ref": "#/$defs/MetadataField"
    },
    "category": {
      "$ref": "#/$defs/MetadataField"
    },
    "edition": {
      "$ref": "#/$defs/MetadataField"
    },
    "editor": {
      "$ref": "#/$defs/MetadataField"
    },
    "genre_primary": {
      "$ref": "#/$defs/MetadataField"
    },
    "genre_secondary": {
      "items": {
        "$ref": "#/$defs/MetadataField"
      },
      "title": "Genre Secondary",
      "type": "array"
    },
    "issues": {
      "items": {
        "type": "string"
      },
      "title": "Issues",
      "type": "array"
    },
    "language": {
      "$ref": "#/$defs/MetadataField"
    },
    "missing_fields": {
      "items": {
        "type": "string"
      },
      "title": "Missing Fields",
      "type": "array"
    },
    "pub_ref": {
      "title": "Pub Ref",
      "type": "string"
    },
    "publisher": {
      "$ref": "#/$defs/MetadataField"
    },
    "title": {
      "$ref": "#/$defs/MetadataField"
    },
    "title_variants": {
      "items": {
        "type": "string"
      },
      "title": "Title Variants",
      "type": "array"
    },
    "volumes": {
      "$ref": "#/$defs/MetadataField"
    },
    "year_gregorian": {
      "$ref": "#/$defs/MetadataField"
    },
    "year_hijri": {
      "$ref": "#/$defs/MetadataField"
    }
  },
  "required": [
    "pub_ref",
    "title",
    "title_variants",
    "author",
    "editor",
    "publisher",
    "edition",
    "year_hijri",
    "year_gregorian",
    "volumes",
    "language",
    "category",
    "genre_primary",
    "genre_secondary",
    "missing_fields",
    "issues"
  ],
  "title": "BookMetadata",
  "type": "object"
}
