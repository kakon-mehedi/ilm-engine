{
  "$defs": {
    "Anchor": {
      "additionalProperties": false,
      "description": "Pointer to an exact span of an original block. `block.text[start:end] == quote` is checked by\n`validation/evidence.py`, which needs the block text.",
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "block_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Block Hash",
          "type": "string"
        },
        "block_id": {
          "title": "Block Id",
          "type": "string"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "page": {
          "title": "Page",
          "type": "integer"
        },
        "pub_ref": {
          "title": "Pub Ref",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "quote_truncated": {
          "default": false,
          "title": "Quote Truncated",
          "type": "boolean"
        },
        "scan_page": {
          "title": "Scan Page",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "status": {
          "default": "valid",
          "enum": [
            "valid",
            "stale",
            "orphaned"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "pub_ref",
        "page",
        "scan_page",
        "block_id",
        "start",
        "end",
        "quote",
        "block_hash"
      ],
      "title": "Anchor",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "How a value was produced. Attached to every derived record.",
      "properties": {
        "method": {
          "enum": [
            "structural",
            "rule",
            "nlp",
            "llm",
            "llm_consensus",
            "human"
          ],
          "title": "Method",
          "type": "string"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "prompt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Id"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "step": {
          "title": "Step",
          "type": "string"
        },
        "step_version": {
          "title": "Step Version",
          "type": "string"
        }
      },
      "required": [
        "method",
        "step",
        "step_version"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RelationshipAttrs": {
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Id"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "full",
                "paternal",
                "maternal",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "mother_status": {
          "anyOf": [
            {
              "enum": [
                "umm_walad",
                "named",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mother Status"
        },
        "via_parent_entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Via Parent Entity Id"
        }
      },
      "title": "RelationshipAttrs",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assertion": {
      "enum": [
        "stated",
        "inferred"
      ],
      "title": "Assertion",
      "type": "string"
    },
    "attrs": {
      "$ref": "#/$defs/RelationshipAttrs",
      "default": {
        "group_id": null,
        "kind": null,
        "mother_status": null,
        "via_parent_entity_id": null
      }
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Anchor"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "object_entity_id": {
      "title": "Object Entity Id",
      "type": "string"
    },
    "origin": {
      "enum": [
        "author_text",
        "transmission_isnad",
        "editor_text",
        "editor_footnote",
        "ai_generated"
      ],
      "title": "Origin",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "relation_id": {
      "title": "Relation Id",
      "type": "string"
    },
    "review_status": {
      "enum": [
        "auto_approved",
        "pending_review",
        "approved",
        "rejected",
        "edited",
        "reprocess_requested"
      ],
      "title": "Review Status",
      "type": "string"
    },
    "sensitive": {
      "default": [],
      "items": {
        "enum": [
          "prophetic_attribution",
          "hadith_grading",
          "fiqh_ruling",
          "aqeedah_proposition",
          "narrator_disambiguation"
        ],
        "type": "string"
      },
      "title": "Sensitive",
      "type": "array"
    },
    "subject_entity_id": {
      "title": "Subject Entity Id",
      "type": "string"
    },
    "type": {
      "enum": [
        "child_of",
        "parent_of",
        "sibling_of",
        "spouse_of",
        "mother_is",
        "teacher_of",
        "student_of",
        "narrated_from"
      ],
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "relation_id",
    "type",
    "subject_entity_id",
    "object_entity_id",
    "evidence",
    "origin",
    "assertion",
    "confidence",
    "review_status",
    "provenance"
  ],
  "title": "Relationship",
  "type": "object"
}
