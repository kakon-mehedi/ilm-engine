{
  "$defs": {
    "Anchor": {
      "additionalProperties": false,
      "description": "Pointer to an exact span of an original block. `block.text[start:end] == quote` is checked by\n`validation/evidence.py`, which needs the block text.",
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "block_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Block Hash",
          "type": "string"
        },
        "block_id": {
          "title": "Block Id",
          "type": "string"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "page": {
          "title": "Page",
          "type": "integer"
        },
        "pub_ref": {
          "title": "Pub Ref",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "quote_truncated": {
          "default": false,
          "title": "Quote Truncated",
          "type": "boolean"
        },
        "scan_page": {
          "title": "Scan Page",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "status": {
          "default": "valid",
          "enum": [
            "valid",
            "stale",
            "orphaned"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "pub_ref",
        "page",
        "scan_page",
        "block_id",
        "start",
        "end",
        "quote",
        "block_hash"
      ],
      "title": "Anchor",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "anchors": {
      "items": {
        "$ref": "#/$defs/Anchor"
      },
      "title": "Anchors",
      "type": "array"
    },
    "confidence": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Confidence"
    },
    "context_block_ids": {
      "items": {
        "type": "string"
      },
      "title": "Context Block Ids",
      "type": "array"
    },
    "issues": {
      "items": {
        "type": "string"
      },
      "title": "Issues",
      "type": "array"
    },
    "model_outputs": {
      "default": [],
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Model Outputs",
      "type": "array"
    },
    "pdf": {
      "additionalProperties": true,
      "title": "Pdf",
      "type": "object"
    },
    "priority": {
      "minimum": 0,
      "title": "Priority",
      "type": "integer"
    },
    "proposed_value": {
      "title": "Proposed Value"
    },
    "reason": {
      "items": {
        "enum": [
          "low_confidence",
          "sensitive",
          "discrepancy",
          "needs_llm",
          "structural_issue"
        ],
        "type": "string"
      },
      "title": "Reason",
      "type": "array"
    },
    "required_role": {
      "enum": [
        "editor_reviewer",
        "scholar_reviewer"
      ],
      "title": "Required Role",
      "type": "string"
    },
    "review_id": {
      "title": "Review Id",
      "type": "string"
    },
    "sensitive": {
      "default": [],
      "items": {
        "enum": [
          "prophetic_attribution",
          "hadith_grading",
          "fiqh_ruling",
          "aqeedah_proposition",
          "narrator_disambiguation"
        ],
        "type": "string"
      },
      "title": "Sensitive",
      "type": "array"
    },
    "status": {
      "default": "pending_review",
      "enum": [
        "auto_approved",
        "pending_review",
        "approved",
        "rejected",
        "edited",
        "reprocess_requested"
      ],
      "title": "Status",
      "type": "string"
    },
    "target_id": {
      "title": "Target Id",
      "type": "string"
    },
    "target_kind": {
      "title": "Target Kind",
      "type": "string"
    }
  },
  "required": [
    "review_id",
    "target_kind",
    "target_id",
    "reason",
    "required_role",
    "priority",
    "confidence",
    "proposed_value",
    "anchors",
    "context_block_ids",
    "pdf",
    "issues"
  ],
  "title": "ReviewItem",
  "type": "object"
}
